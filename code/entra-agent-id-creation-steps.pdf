OIDC Issuer: https://westeurope.oic.prod-aks.azure.com/ea380bf2-1834-45c0-a448-4ae8d224f127/6926a382-905d-4c92-87de-3c79ba997d75/

#Create Kubernetes Namespace
kubectl create ns entra-agent-poc

#Create Kubernetes service account
kubectl create serviceaccount sa-entra-agent-poc --namespace entra-agent-poc

system:serviceaccount:<namespace>:<service-account-name>

system:serviceaccount:entra-agent-poc:sa-entra-agent-poc

#Get Token for Graph API to create blueprint
Connect-MgGraph -Scopes "AgentIdentityBlueprint.Create", "AgentIdentityBlueprint.AddRemoveCreds.All", "AgentIdentityBlueprint.UpdateAuthProperties.All", "AgentIdentityBlueprintPrincipal.Create", "User.Read" -TenantId ea380bf2-1834-45c0-a448-4ae8d224f127
Get-MgContext
$response = Invoke-MgGraphRequest -Uri "https://graph.microsoft.com/v1.0/me" -Method GET -OutputType HttpResponseMessage
$token = $response.RequestMessage.Headers.Authorization.Parameter
$token


#Create Blueprint:
curl --location 'https://graph.microsoft.com/v1.0/applications/' \
--header 'Content-Type: application/json' \
--header 'OData-Version: 4.0' \
--header 'Authorization: <Graph-Token>' \
--data-raw '{
  "@odata.type": "Microsoft.Graph.AgentIdentityBlueprint",
  "displayName": "Entra Agent Identity Blueprint1",
  "sponsors@odata.bind": [
    "https://graph.microsoft.com/v1.0/users/3f534f99-77eb-4133-9b9f-8cdd8a820e56"
  ],
  "owners@odata.bind": [
    "https://graph.microsoft.com/v1.0/users/3f534f99-77eb-4133-9b9f-8cdd8a820e56"
  ]
}'

