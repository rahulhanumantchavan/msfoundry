#Create Kubernetes Service Account Token
kubectl create token <SERVICE_ACCOUNT_NAME> \
  --namespace <NAMESPACE> \
  --audience "<CLOUD_PROVIDER_AUDIENCE>" \
  --duration 3600s
  
kubectl create token sa-entra-agent-poc \
  --namespace entra-agent-poc \
  --audience "api://AzureADTokenExchange" \
  --duration 3600s

