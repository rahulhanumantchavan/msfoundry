{
    "schema_version": "1.0",
    "target": {
        "kind": "saved"
    },
    "allow_code": true,
    "min_pass_rate": 1,
    "evaluators": [
        {
            "id": "contains",
            "kind": "python",
            "required": true,
            "threshold": 1,
            "config": {
                "entrypoint": "examples.plugins:contains_expected"
            }
        },
        {
            "id": "cli",
            "kind": "cli",
            "required": true,
            "threshold": 1,
            "config": {
                "command": [
                    "{python}",
                    "-m",
                    "examples.cli_evaluator"
                ]
            }
        }
    ]
}